# Auth signing secret. Also salts IP hashes. At least 32 characters.
BETTER_AUTH_SECRET=

# Public base URL (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional; Google button stays visible but returns an error until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production database (Turso). Omit locally to use file:./local.db
# Accepts libsql://…, https://…, or turso://… (normalized automatically).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Protects GET /api/cron/cleanup
CRON_SECRET=

# Comma-separated WebSocket trackers and STUN servers
NEXT_PUBLIC_TRACKERS=wss://tracker.openwebtorrent.com,wss://tracker.webtorrent.dev
NEXT_PUBLIC_STUN=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478

# Footer report link (displayed only — Emfile v1 sends no email at all)
REPORT_EMAIL=report@emfile.site
